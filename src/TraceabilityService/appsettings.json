{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "Traceability": {
    "FactoryFacility": "FACTORY-01"
  },
  "Auth": {
    "Issuer": "wonrich-auth",
    "Audience": "wonrich-services"
  },
  "ConnectionStrings": {
    "TraceabilityDb": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "Kafka": {
    "BootstrapServers": "localhost:29092",
    "SecurityProtocol": "Plaintext",
    "SaslMechanism": "",
    "SaslUsername": "",
    "SaslPassword": "",
    "Topics": {
      "StageEvents": "wonrich.processing.stage-events.v1",
      "HoldEvents": "wonrich.processing.hold-events.v1",
      "StageEventsDeadLetter": "wonrich.dlq.traceability-stage-events.v1",
      "HoldEventsDeadLetter": "wonrich.dlq.traceability-hold-events.v1",
      "BatchDeterminations": "wonrich.quality-lab.batch-determinations.v1",
      "BatchDeterminationsDeadLetter": "wonrich.dlq.traceability-batch-determinations.v1",
      "ConsignmentTested": "wonrich.intake.consignment-tested.v1",
      "ConsignmentTestedDeadLetter": "wonrich.dlq.traceability-consignment-tested.v1"
    },
    "ConsumerGroups": {
      "StageEvents": "traceability-stage-events",
      "HoldEvents": "traceability-hold-events",
      "BatchDeterminations": "traceability-batch-determinations",
      "ConsignmentTested": "traceability-consignment-tested"
    },
    "Consumers": {
      "Enabled": true
    }
  },
  "Services": {
    "Auth": {
      "BaseUrl": ""
    },
    "MccIntake": {
      "BaseUrl": "",
      "TimeoutSeconds": 10,
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "Upstream": {
    "MaxAttempts": 10,
    "PollIntervalSeconds": 30
  }
}
