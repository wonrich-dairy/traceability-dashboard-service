<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>be104682-80d0-4c76-9462-66333e74d737</UserSecretsId>
    <!-- Writes TraceabilityService.xml next to the dll, which Swagger renders (SCRUM-125).
         CS1591 and CS1573 off: not every public member, nor every parameter, needs a comment. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <!-- Versions are pinned exactly so every build restores the same packages. -->
  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="2.15.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <!-- Swagger as in the shared service template (SCRUM-49, MCC and Intake): same packages and versions. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <!-- BatchCleared / BatchFailed contracts, as published by Quality Lab (tag contracts-v1.0.0 = schemaVersion v1).
         From the org's GitHub Packages feed, see nuget.config. -->
    <PackageReference Include="Wonrich.QualityLab.Contracts" Version="1.0.0" />
    <!-- Stage and hold event contracts, as published by Processing (tag contracts-v1.0.0 = schemaVersion v1). -->
    <PackageReference Include="Wonrich.Processing.Contracts" Version="1.0.0" />
  </ItemGroup>

</Project>