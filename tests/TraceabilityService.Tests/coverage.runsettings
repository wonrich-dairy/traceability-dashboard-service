<?xml version="1.0" encoding="utf-8"?>
<!-- Picked up automatically via RunSettingsFilePath in the test csproj, so plain
     dotnet test with the "XPlat Code Coverage" collector uses it. Source-generator output under obj/
     (the OpenAPI XML comment generator alone is ~380 lines) is not code we wrote, and would
     otherwise drag the headline percentage down. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <ExcludeByFile>**/obj/**/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
