# Copy to .env and fill in. .env is git-ignored; never commit real values.

# ── Database (remote MySQL, scoped user trc_app) ─────────────────────────────
TRC_DB_CONNECTION=Server=wonrichmysql.mysql.database.azure.com;Port=3306;Database=traceability;User=trc_app;Password=<password, never commit>;SslMode=Required;

# ── Kafka ────────────────────────────────────────────────────────────────────
# Local (wonrich-infra docker compose), the defaults:
#   KAFKA_BOOTSTRAP_SERVERS=kafka:9092
#   KAFKA_SECURITY_PROTOCOL=Plaintext
#
# Staging broker on the Azure VM:
#   KAFKA_BOOTSTRAP_SERVERS=wonrich-kafka.southeastasia.cloudapp.azure.com:9094
#   KAFKA_SECURITY_PROTOCOL=SaslPlaintext
#   KAFKA_SASL_MECHANISM=Plain
#   KAFKA_SASL_USERNAME=wonrich
#   KAFKA_SASL_PASSWORD=<password, never commit>
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=Plaintext
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ── MCC and Intake Service (service-to-service) ──────────────────────────────
MCC_INTAKE_BASE_URL=
MCC_INTAKE_CLIENT_ID=
MCC_INTAKE_CLIENT_SECRET=

# ── Frontend origin allowed by CORS ──────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# Host port (5003 Quality Lab, 5210 Processing, 5237 Intake, 5238 Auth are taken)
# TRC_HOST_PORT=5240
