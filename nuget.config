<?xml version="1.0" encoding="utf-8"?>
<!--
  Package feeds for Traceability Service.

  Wonrich.* packages (Wonrich.QualityLab.Contracts, SCRUM-131) come from the org's GitHub Packages
  feed, and only from there: source mapping stops nuget.org from ever supplying a package with a
  Wonrich.* name (dependency confusion). Everything else comes from nuget.org.

  The feed needs a GitHub token with read:packages in GITHUB_PACKAGES_TOKEN:
    local:  export GITHUB_PACKAGES_TOKEN=$(gh auth token)   (after: gh auth refresh -s read:packages)
    CI:     the workflow's GITHUB_TOKEN, with packages: read
    Docker: passed as the build secret github_packages_token, never as a build arg
  GitHub ignores the username for token authentication, so it is fixed here.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="wonrich-github" value="https://nuget.pkg.github.com/wonrich-dairy/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="wonrich-github">
      <package pattern="Wonrich.*" />
    </packageSource>
  </packageSourceMapping>

  <packageSourceCredentials>
    <wonrich-github>
      <add key="Username" value="wonrich-dairy" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </wonrich-github>
  </packageSourceCredentials>
</configuration>
